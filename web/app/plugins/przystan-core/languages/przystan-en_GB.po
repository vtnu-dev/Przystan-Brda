msgid "Podaj imię."
msgstr "Please enter your name."

msgid "Imię jest za krótkie."
msgstr "The name is too short."

msgid "Imię jest za długie."
msgstr "The name is too long."

msgid "Podaj adres e-mail."
msgstr "Please enter your e-mail address."

msgid "Sprawdź adres e-mail, np. jan@przyklad.pl."
msgstr "Check the e-mail address, e.g. jan@example.com."

msgid "Numer telefonu może zawierać tylko cyfry, spacje, +, - i nawiasy."
msgstr "The phone number may contain only digits, spaces, +, - and brackets."

msgid "Wiadomość może mieć najwyżej 2000 znaków."
msgstr "The message can be up to 2000 characters long."

msgid "Potrzebujemy zgody, żeby odpowiedzieć na zapytanie."
msgstr "We need your consent to reply to your enquiry."

msgid "Sprawdź to pole."
msgstr "Please check this field."

msgid "Dziękujemy! Odpowiemy w ciągu jednego dnia roboczego."
msgstr "Thank you! We will reply within one working day."

msgid "Formularz wygasł albo został wysłany zbyt szybko. Odśwież stronę i spróbuj ponownie."
msgstr "The form has expired or was sent too quickly. Refresh the page and try again."

msgid "Popraw zaznaczone pola."
msgstr "Please correct the marked fields."

msgid "Wysłano już kilka zapytań. Spróbuj ponownie za kilka minut albo zadzwoń."
msgstr "Several enquiries have already been sent. Try again in a few minutes or give us a call."

msgid "Nie udało się zapisać zapytania. Zadzwoń do nas, proszę."
msgstr "We could not save your enquiry. Please give us a call."

