{
    "name": "vtnu-dev/przystan-brda",
    "type": "project",
    "license": "proprietary",
    "description": "Przystań Brda - demo WordPress (Bedrock + Sage + własna wtyczka)",
    "homepage": "https://przystan.sitebest.eu",
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "oscarotero/env": "^2.0",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "7.1.3",
        "roots/wp-config": "^1.0",
        "vlucas/phpdotenv": "^5.0",
        "wp-plugin/advanced-custom-fields": "^6.8",
        "wp-plugin/polylang": "^3.8"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "wp-plugin/sqlite-database-integration": "^3.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wp"
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "pest"
    },
    "autoload-dev": {
        "psr-4": {
            "Przystan\\": "web/app/plugins/przystan-core/src/",
            "Tests\\": "tests/"
        }
    }
}
